{
  "name": "pdf-editor-app",
  "private": true,
  "version": "1.7.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation VITE_CJS_IGNORE_WARNING=1 concurrently \"vite\" \"wait-on http://localhost:5173 && electron ./electron/main.js\"",
    "dev:vite": "vite",
    "dev:electron": "electron ./electron/main.js",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "electron-builder",
    "package": "npm run build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test:core": "node scripts/test-refactor.cjs && node scripts/test-terminal-input.cjs",
    "test:ui": "electron scripts/test-ui-lifecycle.cjs && electron scripts/test-terminal-clear.cjs",
    "test:pdfjs": "electron scripts/test-pdfjs-vite.cjs",
    "test:annotations": "node scripts/test-ai-annotations.cjs",
    "test:text-selection": "electron scripts/test-text-selection.cjs",
    "test:cache": "node scripts/test-text-cache.cjs",
    "verify": "npm run typecheck && npm run test:core && npm run test:cache && npm run test:annotations && npm run test:text-selection && npm run test:pdfjs && npm run test:ui && npm run test:plugins && npm run build",
    "test:plugins": "node scripts/test-plugin-editor.cjs && node scripts/test-ai-plugin-drafts.cjs && electron scripts/test-plugin-ai-view.cjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.17.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.5",
    "dotenv": "^16.6.1",
    "fabric": "^5.3.0",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "mousetrap": "^1.6.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "^6.21.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.33",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.pdfeditor.app",
    "productName": "PDF Editor Pro",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    }
  }
}
